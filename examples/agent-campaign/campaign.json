{
  "_template": true,
  "_note": "Campaign manifest TEMPLATE. Replace every <placeholder> and null with measured values. Campaign metadata belongs here, with the campaign, and never in .openforage/settings.yaml. State transitions must follow docs/agents/references/campaign-state-machine.json.",
  "campaign_id": "campaign-<slug>-<YYYYMMDD>",
  "owner_session_identity": "<child-session-identity>",
  "owner_shape": {
    "separate_cli_invocation_of_same_harness": true,
    "distinct_session_identity": true,
    "not_a_python_worker_or_subagent": true
  },
  "state_machine": {
    "definition": "docs/agents/references/campaign-state-machine.json",
    "state": "baseline",
    "revision": 1,
    "resume_target": null,
    "ownership": {
      "owner_session_identity": "<child-session-identity>",
      "owner_revision": 1,
      "fencing_token": "<monotonic-token>",
      "claimed_at": "<ISO-8601>",
      "claim_mechanism": "<atomic-create|verified-equivalent-lock>",
      "claim_verified": false
    },
    "notes": "The library does not supply the claim, lock, or fencing. Never claim exactly-once transitions, submissions, or worker launches."
  },
  "transitions": [
    {
      "transition_id": "T-baseline-start",
      "from": "bootstrapping",
      "to": "baseline",
      "timestamp": "<ISO-8601>",
      "reason": "<why this transition happened>",
      "owner_session_identity": "<child-session-identity>",
      "owner_revision": 1,
      "guard_passed": true
    }
  ],
  "objective": "<one-sentence objective tied to a falsifiable hypothesis>",
  "frozen_baseline": {
    "availability": "<available|unavailable|pending|unknown>",
    "unavailable_reason": "<required when the reference is not available>",
    "id": "<baseline-id-or-sha256-or-null>",
    "hash": "<sha256-or-null>",
    "target_completed_simulations": 100000,
    "observed_completed_simulations": null,
    "frozen": false,
    "algorithm_identity": "<recorded algorithm identity, or a stated unavailable marker>",
    "note": "The 100000 is the completion target, not an observed count. A missing reference keeps null id/hash/observed count and a stated reason; never fabricate numbers. Only completed evaluator simulations count; a final failing-quality evaluation is completed, runtime errors are failed."
  },
  "compatible_baseline": {
    "status": "<found|created|incomplete|missing>",
    "status_reason": "<required when the status is missing or incomplete>",
    "baseline_id": "<compatible-baseline-id-or-null>",
    "lineage": [],
    "config_frozen_before_run": null,
    "evidence_frozen_after_run": null,
    "additional_paired_runs_get_distinct_ids": true,
    "silent_overwrite": false,
    "note": "If no compatible baseline exists for the selected era/config, create a real baseline; freeze the configuration before the run and the evidence after it. Incomplete stays incomplete."
  },
  "preregistration": {
    "protocol_id": "<protocol-id>",
    "protocol_version": 1,
    "recorded_at": "<ISO-8601, before any result>",
    "protocol_hash": "<sha256-of-protocol-artifact>",
    "recorded_before_results": true,
    "hypothesis": "<falsifiable statement>",
    "mechanism": "<why it could hold, and what would falsify it>",
    "primary_metric": "<metric-id>",
    "secondary_metrics": [],
    "direction": "<increase|decrease|two-sided>",
    "minimum_meaningful_effect": null,
    "comparator": "<comparator and its recorded algorithm identity>",
    "seeds_repetitions": {
      "seed_set_id": "<seed-set-id>",
      "search_runs_per_arm": null,
      "predeclared": false
    },
    "evaluation_allocations": {
      "baseline": null,
      "variant": null,
      "pilots_counted_separately": true
    },
    "data_scope": {
      "era_id": "<era-id>",
      "config_hash": "<config-hash>",
      "history_window": "<window>",
      "loaded_vocabulary_hash": "<sha256-or-null>"
    },
    "exclusions": [],
    "look_schedule": {
      "kind": "<fixed_horizon|sequential>",
      "looks": null,
      "sequential_method": null,
      "sequential_justification": null
    },
    "decision_criteria": "<rule for supporting or rejecting the hypothesis>",
    "stopping_criteria": "<preregistered patience/exhaustion rule>",
    "holdout_handling": "<held-out data used only where exposed and authorized; server out-of-sample is not user-tunable>",
    "amendments": [],
    "unavailable_reasons": {}
  },
  "statistics": {
    "unit_of_analysis": "independent_paired_search_runs",
    "candidate_evaluations_are_not_replications": true,
    "inference": {
      "method": "<dependence-aware method>",
      "assumptions": "<stated assumptions>",
      "data_window": "<window>"
    },
    "effect_size": null,
    "uncertainty": null,
    "multiple_comparison_family": null,
    "multiple_comparison_correction": null,
    "classification": "exploratory",
    "trial_inventory": "experiments.jsonl",
    "complete_trial_inventory": false
  },
  "pipeline_stages": {
    "paper": {
      "artifact": "research.md#paper",
      "source": "<citation-or-link>",
      "claim": "<exact source claim>"
    },
    "mechanism": {
      "artifact": "research.md#mechanism",
      "statement": "<why it could hold here>",
      "falsifier": "<what would falsify it>"
    },
    "hypothesis": {
      "artifact": "research.md#hypothesis",
      "statement": "<falsifiable statement>",
      "comparison": "<baseline vs variant>",
      "threshold": "<pre-registered threshold>"
    },
    "custom_algorithm": {
      "artifact": "research.md#custom-algorithm",
