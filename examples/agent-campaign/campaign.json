      "self_rejects_depth_gt_6": true,
      "filler_nodes_added": false,
      "acceptance_thresholds_unchanged": true
    },
    "measured_comparison": {
      "artifact": "experiment_record.json",
      "classification": "exploratory",
      "classification_note": "exploratory never means unmeasured; a result with measurements is still measured data"
    }
  },
  "budgets": {
    "baseline_evaluations": null,
    "variant_evaluations": null,
    "matched": null
  },
  "seed_sets": [
    {
      "seed_set_id": "<seed-set-id>",
      "seeds": [],
