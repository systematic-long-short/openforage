{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper-backed-coverage-fixture-v1",
  "title": "Synthetic-only research coverage fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixture_schema_version", "fixture_id", "evaluation_origin", "target_completed_evaluations_per_arm", "max_callback_yields_per_run", "uniform_reference", "inputs"],
  "properties": {
    "fixture_schema_version": {"const": 1},
    "fixture_id": {"type": "string", "minLength": 1},
    "evaluation_origin": {"const": "synthetic_fixture_only"},
    "target_completed_evaluations_per_arm": {"type": "integer", "minimum": 1},
    "max_callback_yields_per_run": {"type": "integer", "minimum": 1, "maximum": 64},
    "uniform_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "selection", "is_openforage_genetic", "is_library_measurement"],
      "properties": {
        "identity": {"const": "synthetic_uniform_pair_selector_v1"},
        "selection": {"type": "string", "minLength": 1},
        "is_openforage_genetic": {"const": false},
        "is_library_measurement": {"const": false}
      }
    },
    "inputs": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/input"}}
  },
  "$defs": {
    "pair": {
      "type": "object", "additionalProperties": false,
      "required": ["pair_id", "rotation", "feature", "loaded", "eligible", "exclusion_reason"],
      "properties": {
        "pair_id": {"type": "string", "pattern": "^.+\\|.+$"},
        "rotation": {"type": "string", "minLength": 1},
        "feature": {"type": "string", "minLength": 1},
        "loaded": {"type": "boolean"},
        "eligible": {"type": "boolean"},
        "exclusion_reason": {"type": ["string", "null"]}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["payload", "depth", "synthetic_quality_pass"],
      "properties": {
        "payload": {"type": "object"},
        "depth": {"type": ["integer", "null"], "minimum": 1},
        "synthetic_quality_pass": {"type": ["boolean", "null"]}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["input_id", "role", "era_id", "config_id", "paired_seeds", "pairs", "candidate_streams"],
      "properties": {
        "input_id": {"type": "string", "minLength": 1},
        "role": {"enum": ["development", "reserved-heldout"]},
        "era_id": {"type": "string", "minLength": 1},
        "config_id": {"type": "string", "minLength": 1},
        "paired_seeds": {"type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 0}},
        "pairs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pair"}},
        "candidate_streams": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}}
        }
      }
    }
  }
}
