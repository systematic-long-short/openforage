{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper-backed-coverage-native-trial-v1",
  "title": "Sanitized native research trial record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_schema_version", "series_id", "series_manifest_path", "series_manifest_sha256",
    "case_id", "harness", "execution_mode", "fresh_native_invocation", "run_id",
    "workspace_identity_sha256", "snapshot_sha256", "initial_file_sha256", "native_exit_code",
    "native_timed_out", "process_group_remaining", "native_session_id_sha256",
    "native_trace_complete", "native_actions", "raw_events_path", "raw_events_sha256",
    "raw_events_bytes", "raw_stderr_path", "raw_stderr_sha256", "raw_stderr_bytes",
    "artifact_sha256", "expected_snapshot_sha256"
  ],
  "properties": {
    "record_schema_version": {"const": 1},
    "series_id": {"type": "string", "minLength": 1},
    "series_manifest_path": {"type": "string", "minLength": 1},
    "series_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "case_id": {"const": "paper-backed-coverage-challenger"},
    "harness": {"enum": ["opencode", "codex"]},
    "execution_mode": {"const": "fresh-native-run"},
    "fresh_native_invocation": {"const": true},
    "run_id": {"type": "string", "minLength": 1},
    "workspace_identity_sha256": {"$ref": "#/$defs/sha256"},
    "snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "initial_file_sha256": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "native_exit_code": {"type": ["integer", "null"]},
    "native_timed_out": {"type": "boolean"},
    "process_group_remaining": {"type": "boolean"},
    "native_session_id_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "native_trace_complete": {"type": "boolean"},
    "native_actions": {"type": "array", "items": {"type": "object"}},
    "raw_events_path": {"type": "string", "minLength": 1},
    "raw_events_sha256": {"$ref": "#/$defs/sha256"},
    "raw_events_bytes": {"type": "integer", "minimum": 0},
    "raw_stderr_path": {"type": "string", "minLength": 1},
    "raw_stderr_sha256": {"$ref": "#/$defs/sha256"},
    "raw_stderr_bytes": {"type": "integer", "minimum": 0},
    "artifact_sha256": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "expected_snapshot_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
