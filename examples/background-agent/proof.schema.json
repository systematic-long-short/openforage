{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "proof.schema.json",
  "title": "Bounded native background-agent proof v2",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_class",
    "adapter_interface_version",
    "adapter_id",
    "proof_id",
    "harness",
    "product",
    "harness_version",
    "os",
    "scope",
    "adapter_profile",
    "proof_applicability",
    "source_file_digests",
    "request_acknowledgements",
    "native_primitive_observations",
    "conformance",
    "failures",
    "passed"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "evidence_class": {"enum": ["bounded-native-background-agent-proof", "failed-bounded-native-background-agent-proof"]},
    "adapter_interface_version": {"const": 1},
    "adapter_id": {"enum": ["opencode", "codex", "claude-code"]},
    "proof_id": {"type": "string", "minLength": 1},
    "harness": {"type": "string", "minLength": 1},
    "product": {"type": "string", "minLength": 1},
    "harness_version": {"type": "string", "minLength": 1},
    "model": {"type": "string"},
    "variant": {"type": ["string", "null"]},
    "reasoning_effort": {"type": ["string", "null"]},
    "effort": {"type": ["string", "null"]},
    "os": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "proof_applicability": {"type": "string", "minLength": 1},
    "adapter_profile": {
      "type": "object",
      "required": ["selected", "scope", "limitation"],
      "properties": {
        "selected": {"const": "isolated"},
        "scope": {"type": "string"},
        "limitation": {"type": "string"}
      },
      "additionalProperties": true
    },
    "source_file_digests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["sha256", "bytes"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "request_acknowledgements": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["adapter_id", "product_version", "os", "profile", "request_id", "turn_id", "kind", "fence", "task_sha256", "process_exit_code", "native_result_event_observed", "ack_binding_matches", "target_session_fingerprint", "related_session_fingerprint", "returned_session_fingerprint"],
        "properties": {
          "adapter_id": {"type": "string"},
          "product_version": {"type": "string"},
          "os": {"type": "string"},
          "profile": {"type": "string"},
          "request_id": {"type": ["string", "null"]},
          "turn_id": {"type": ["string", "null"]},
          "kind": {"type": ["string", "null"]},
          "fence": {"type": ["integer", "null"]},
          "task_sha256": {"type": ["string", "null"]},
          "command_sha256": {"type": ["string", "null"]},
          "process_exit_code": {"type": ["integer", "null"]},
          "native_result_event_observed": {"type": "boolean"},
          "ack_binding_matches": {"type": "boolean"},
          "target_session_fingerprint": {"type": ["string", "null"]},
          "related_session_fingerprint": {"type": ["string", "null"]},
          "returned_session_fingerprint": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "native_primitive_observations": {"$ref": "#/$defs/nativeEvidence"},
    "conformance": {"$ref": "conformance.schema.json"},
    "failures": {"type": "array", "items": {"type": "string"}},
    "passed": {"type": "boolean"}
  },
  "$defs": {
    "nativeEvent": {
      "type": "object",
      "required": ["tool", "event_type", "event_ref", "status", "scope"],
      "properties": {
        "tool": {"type": ["string", "null"]},
        "event_type": {"type": ["string", "null"]},
        "event_ref": {"type": ["string", "null"]},
        "status": {"type": ["string", "null"]},
        "operation": {"type": "string"},
        "native_delivery": {"type": "boolean"},
        "delivery_id": {"type": "string"},
        "durable_readback": {"type": "boolean"},
        "resource_id": {"type": "string"},
        "result_resource_id": {"type": "string"},
        "scope": {
          "type": "object",
          "required": ["adapter_id", "product_version", "os", "profile", "run_id", "request_id", "turn_id", "fence", "session_fingerprint"],
          "properties": {
            "adapter_id": {"type": "string"},
            "product_version": {"type": ["string", "null"]},
            "os": {"type": ["string", "null"]},
            "profile": {"type": ["string", "null"]},
            "run_id": {"type": ["string", "null"]},
            "request_id": {"type": ["string", "null"]},
            "turn_id": {"type": ["string", "null"]},
            "fence": {"type": ["integer", "null"]},
            "session_fingerprint": {"type": ["string", "null"]},
            "proof_id": {"type": "string"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "nativeOperation": {
      "type": "object",
      "required": ["availability", "outcome", "tool_names_declared", "evidence", "scope", "reason", "declaration_basis"],
      "properties": {
        "availability": {"enum": ["documented", "unknown", "unavailable"]},
        "outcome": {"enum": ["observed_success", "observed_failure", "observed_in_progress", "observed_mixed", "unavailable", "unknown"]},
        "tool_names_declared": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/nativeEvent"}},
        "scope": {"type": "object"},
        "reason": {"type": ["string", "null"]},
        "declaration_basis": {"type": "string"}
      },
      "additionalProperties": false
    },
    "nativeEvidence": {
      "type": "object",
      "required": ["schema_version", "evidence_class", "operations", "external_delivery_is_native_scheduler_evidence"],
      "properties": {
        "schema_version": {"const": 1},
        "evidence_class": {"const": "typed-native-operation-observations"},
        "operations": {
          "type": "object",
          "required": ["goal_declaration", "task_creation", "task_list_write", "task_durable_reread", "task_state_update", "memory_write", "memory_durable_reread", "native_scheduler_creation", "native_scheduler_delivery"],
          "properties": {
            "goal_declaration": {"$ref": "#/$defs/nativeOperation"},
            "task_creation": {"$ref": "#/$defs/nativeOperation"},
            "task_list_write": {"$ref": "#/$defs/nativeOperation"},
            "task_durable_reread": {"$ref": "#/$defs/nativeOperation"},
            "task_state_update": {"$ref": "#/$defs/nativeOperation"},
            "memory_write": {"$ref": "#/$defs/nativeOperation"},
            "memory_durable_reread": {"$ref": "#/$defs/nativeOperation"},
            "native_scheduler_creation": {"$ref": "#/$defs/nativeOperation"},
            "native_scheduler_delivery": {"$ref": "#/$defs/nativeOperation"}
          },
          "additionalProperties": false
        },
        "external_delivery_is_native_scheduler_evidence": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
